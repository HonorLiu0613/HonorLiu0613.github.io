---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title | xml_escape }} — Notes</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.name | xml_escape }}</name></author>
  {% assign notes = site.notes | where: 'publish', true | sort: 'updated' | reverse %}
  {% for note in notes limit: 20 %}
  <entry>
    <title>{{ note.title | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ note.url | absolute_url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.updated | default: note.date | date_to_xmlschema }}</updated>
    <summary>{{ note.excerpt | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
